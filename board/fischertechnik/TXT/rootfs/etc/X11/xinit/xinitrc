#!/bin/sh


set_locale()
{
  source /etc/locale
  export LC_ALL
}

set_background()
{
  xsetroot -solid '#5c96cc'
}

start_vnc()
{
  ENABLED=no
  conffile=/etc/default/x11vnc
  # to enable, add ENABLED=yes to $conffile
  [ -f $conffile ] && . $conffile
  if [ $ENABLED = "yes" ]; then
    sudo -u ftc x11vnc -display :0 -forever &
  fi
}

setup_fontconfig_cache()
{
  if [ -d /home/ftc ] && mkdir -p /home/ftc/.cache/fontconfig 2>/dev/null; then
    chown ftc:ftc /home/ftc/.cache /home/ftc/.cache/fontconfig 2>/dev/null || true
    ln -sfn /home/ftc/.cache/fontconfig /var/cache/fontconfig
  fi
}

start_launcher()
{
  # /opt/ftc is precompiled at build time; user apps write __pycache__ on rw /home
  sudo -u ftc PYTHONWARNINGS=ignore::DeprecationWarning PYTHONPATH=/opt/ftc /opt/ftc/launcher.py
}

set_locale
set_background
setup_fontconfig_cache
start_vnc
while true; do
    start_launcher
done
      
